{
  "name": "Containment Detail",
  "short_name": "Containment",
  "description": "A cooperative-design containment operation: learn the anomaly's rules, build a field procedure, establish custody. Browser build.",
  "lang": "en-GB",
  "dir": "ltr",
  "categories": ["games"],

  "_note": "Underscore keys are notes, not manifest members; browsers ignore what they do not know. The convention is the one content/site.json and every incident package already use — a null or a bare value in this repo is expected to say why it is what it is.",

  "id": "./",
  "start_url": "./",
  "scope": "./",
  "_urlNote": "All three are relative on purpose. The same bytes serve from http://localhost:8401/ in development and from /ContainmentDetailWeb/ on Pages, which is the URL discipline src/sim/content.js and src/core/i18n.js already keep. An absolute start_url would install an app that only works on one of them.",

  "display": "standalone",
  "_displayNote": "NOT fullscreen, and the reason is Escape. This is a pointer-locked first-person game: src/core/input.js lists Escape among the keys nothing may bind, because Escape is how the player leaves pointer lock and the browser owns it. A manifest asking for display:fullscreen gives Escape a SECOND owner and it fires first — the first press exits the app's fullscreen instead of releasing the mouse, and the player is looking at their desktop rather than at the pause they asked for. standalone drops the URL bar and the tab strip, which is the actual win (a pointer-locked game with an address bar above it looks broken), keeps a resizable window, and leaves Escape entirely to the game. Anyone who wants true fullscreen still has F11, where it is one key and one meaning.",

  "orientation": "landscape",
  "_orientationNote": "Ignored on desktop, where almost all play happens. It is here for the touch build tools/tablet-tests.js covers: the HUD is laid out across the bottom of a wide viewport and a portrait phone puts the slot row over the crosshair.",

  "background_color": "#05070a",
  "theme_color": "#0e1218",
  "_colourNote": "Read out of index.html's :root, not chosen. background_color is --bg, the colour behind every frame the game draws, so the install splash is the same black the canvas clears to and there is no flash on launch. theme_color is --panel, the colour of every panel in the game — the browser's chrome then matches the game's chrome rather than its void. tools/platform-tests.js parses index.html and asserts both still match, so a palette change cannot leave this file lying.",

  "icons": [
    { "src": "assets/icons/icon-48.png",  "sizes": "48x48",   "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "_iconNote": "The mark is COMMS_KIND.evidence's glyph from src/sim/comms.js — a thing held inside a boundary, which is the game's title in one character and the only mark in that set that survives 48px. Generated by tools/make-icons.ps1 through the same headless-Chrome pipeline as tools/shot.ps1, in the palette read out of index.html. The maskable variant keeps the mark inside the 80% safe circle and pads with --bg; platform-tests.js measures that the outer ring is uniform rather than trusting it."
}
